# Kestrel Warranty Fraud Risk Platform - Environment Variables Example
# Copy this file to .env and configure your Zapier Catch Hook URL.
# NEVER commit .env to version control.

# Zapier Catch Hook Webhook URL (outbound alerts for HIGH-risk claims)
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxx/yyyyyy/

# Groq AI Investigation Assistant Configuration
# Sign up at https://console.groq.com to obtain a free API key
GROQ_API_KEY=gsk_your_groq_api_key_here
# Model identifier (Default: llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile
